{
  "name": "reckon-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "start": "tsx service.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/diagnostic-validation.ts && node --import tsx tests/diagnostic-callback.ts && node --import tsx tests/diagnostic-code.ts && npm run test:contract && playwright test",
    "test:contract": "tsx tests/contract.ts",
    "prestart": "sh scripts/check-local.sh",
    "pretest": "sh scripts/check-local.sh",
    "pretest:contract": "sh scripts/check-local.sh",
    "build:contract": "cargo build --manifest-path contract/Cargo.toml --release --target wasm32-unknown-unknown --locked",
    "lint": "eslint . && cargo fmt --manifest-path contract/Cargo.toml --check",
    "audit:high": "npm audit --audit-level=high",
    "build:diagnostic": "cargo build --manifest-path diagnostic-contract/Cargo.toml --release --target wasm32-unknown-unknown --locked",
    "test:diagnostic-contract": "npm run build:diagnostic && tsx tests/diagnostic-contract.ts",
    "archive:evidence": "tsx scripts/archive-evidence.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "near-api-js": "5.1.1",
    "near-workspaces": "5.0.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "25.2.3",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.23"
    },
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
